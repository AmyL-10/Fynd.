    SchedulerBinding.instance.addPostFrameCallback((_) async {
      // qCurrentChat
      _model.qCurrentChat = await queryChatsRecordOnce(
        queryBuilder: (chatsRecord) => chatsRecord.where(Filter.or(
          Filter(
            'userARef',
            isEqualTo: widget!.otherUserRef?.reference,
          ),
          Filter(
            'userBRef',
            isEqualTo: widget!.otherUserRef?.reference,
          ),
          Filter(
            'pairKey',
            isEqualTo: widget!.chatReference?.id,
          ),
        )),
        singleRecord: true,
      ).then((s) => s.firstOrNull);
      // qCurrentChatMessages
      _model.messagesCurrentChat = await queryMessagesRecordOnce(
        parent: widget!.chatReference,
        queryBuilder: (messagesRecord) =>
            messagesRecord.orderBy('timestamp', descending: true),
      );
      if ((_model.qCurrentChat?.lastMessageDetails?.lastMessageFrom ==
              widget!.otherUserRef?.reference) &&
          (_model.qCurrentChat?.lastMessageDetails?.lastMessageStatus ==
              MessageStatus.unread.name)) {
        await _model.qCurrentChat!.reference.update({
          ...createChatsRecordData(
            lastMessageDetails: createChatMessageDetailsStruct(
              lastMessageStatus: MessageStatus.read.name,
              fieldValues: {
                'last_message_read_timestamp': FieldValue.serverTimestamp(),
              },
              clearUnsetFields: false,
            ),
          ),
          ...mapToFirestore(
            {
              'lastUpdated': FieldValue.serverTimestamp(),
            },
          ),
        });
      }
      // qUnreadMssgs
      _model.unreadsCurrentChat = await queryMessagesRecordOnce(
        parent: widget!.chatReference,
        queryBuilder: (messagesRecord) => messagesRecord
            .where(
              'recieverRef',
              isEqualTo: currentUserReference,
            )
            .where(
              'senderRef',
              isEqualTo: widget!.otherUserRef?.reference,
            )
            .where(
              'message_status',
              isEqualTo: MessageStatus.unread.name,
            ),
      );
      for (int loop1Index = 0;
          loop1Index < _model.unreadsCurrentChat!.length;
          loop1Index++) {
        final currentLoop1Item = _model.unreadsCurrentChat![loop1Index];

        await currentLoop1Item.reference.update({
          ...createMessagesRecordData(
            messageStatus: MessageStatus.read.name,
          ),
          ...mapToFirestore(
            {
              'readTimestamp': FieldValue.serverTimestamp(),
            },
          ),
        });
        _model.addToPvReadMessages(currentLoop1Item.reference);
        safeSetState(() {});
        await currentLoop1Item.notificationRef!.delete();
      }
    });

    _model.textController ??= TextEditingController();
    _model.textFieldFocusNode ??= FocusNode();

    WidgetsBinding.instance.addPostFrameCallback((_) => safeSetState(() {}));
  }


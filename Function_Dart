String? strlat(
  LatLng geoLoc,
  bool isLatt,
) {
  if (isLatt) {
    return geoLoc.latitude.toString();
  } else {
    return geoLoc.longitude.toString();
  }
}

double? fnLattLong(
  LatLng geoLoc,
  bool isLatt,
) {
  if (isLatt) {
    // Check for null-safety or invalid numbers
    final lat = geoLoc.latitude;
    return lat.isNaN ? 0.0 : lat;
  } else {
    final lon = geoLoc.longitude;
    return lon.isNaN ? 0.0 : lon;
  }
}

double? fnCalculateDistance(
  double x1,
  double x2,
  double y1,
  double y2,
) {
  return math.sqrt(math.pow((x2 - x1), 2) + math.pow((y2 - y1), 2));
}

double fnCalculateDistanceLoc(
  LatLng loc1,
  LatLng loc2,
) {
  double x1, x2, y1, y2;

  y1 = double.parse(loc1.longitude.toString());
  y2 = double.parse(loc2.longitude.toString());
  x1 = double.parse(loc1.latitude.toString());
  x2 = double.parse(loc2.latitude.toString());

  return math.sqrt(math.pow((x2 - x1), 2) + math.pow((y2 - y1), 2));
}

